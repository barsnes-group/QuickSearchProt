<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>no.uib.probe</groupId>
    <artifactId>QuickSearchProt</artifactId>
    <version>2.0</version>
    <packaging>jar</packaging>
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>19</maven.compiler.source>
        <maven.compiler.target>19</maven.compiler.target>
        <exec.mainClass>no.uib.probe.quicksearchprot.QuickSearchProt</exec.mainClass>
        <utilities.version>5.1.12_quicksprot</utilities.version>
        <searchgui.version>4.3.11_quicksprot</searchgui.version>
        <peptideshaker.version>3.0.9-beta_quicksprot</peptideshaker.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.8.9</version>
        </dependency>

        <dependency>
            <groupId>eu.isas.peptideshaker</groupId>
            <artifactId>PeptideShaker</artifactId>
            <version>${peptideshaker.version}</version>
        </dependency>
        <dependency>
            <groupId>eu.isas.searchgui</groupId>
            <artifactId>SearchGUI</artifactId>
            <version>${searchgui.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jfree</groupId>
            <artifactId>org.jfree.svg</artifactId>
            <version>5.0.6</version>
        </dependency>
       
    </dependencies>
    <build>  

        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>src/extra</directory> <!-- Your additional resource folder -->
            </resource>
        </resources>

        
        <plugins>  
            <plugin>  
                <!-- Build an executable JAR -->  
                <groupId>org.apache.maven.plugins</groupId>  
                <artifactId>maven-jar-plugin</artifactId>  
                <version>3.1.0</version>  
                <configuration>  
                    <archive>  
                        <manifest>  
                            <mainClass>${exec.mainClass}</mainClass>  
                        </manifest>  
                    </archive>  
                </configuration>  
            </plugin>  
       
            <!-- any other plugins -->
            <plugin>
                <artifactId>maven-assembly-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <descriptorRefs>
                        <descriptorRef>jar-with-dependencies</descriptorRef>
                    </descriptorRefs>
          
                    <archive>  
                        <manifest>  
                            <mainClass>${exec.mainClass}</mainClass>  
                        </manifest>  
                    </archive>
                </configuration>
            </plugin>
    
           
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>1.8</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <tasks>
                                <copy file="D:\Apps\QuickSearchProt\quicksearchprot\configurations.json" tofile="${project.build.directory}/configurations.json"/>                      
                                <copy  todir="${project.build.directory}/searchengines">
                                    <fileset dir="D:\Apps\QuickSearchProt\searchengines"/>
                                </copy>
                                 <copy  todir="${project.build.directory}/testdata">
                                    <fileset dir="D:\Apps\QuickSearchProt\testdata"/>
                                </copy>

                            </tasks>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            
        </plugins>
    </build>
    
      
</project>